# Copy this file to `.env` and adjust the values for your machine.
# `.env` is git-ignored — never commit real secrets.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local MongoDB. For an Atlas cluster use the SRV string instead:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/workforce
MONGODB_URI=mongodb://127.0.0.1:27017/workforce

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------
# Secret used to sign the session cookie. Use at least 32 random characters in
# production, for example: openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-string-before-deploying
# How long a signed-in session stays valid, in hours.
SESSION_HOURS=8
# Password hashing cost. Higher is slower and safer; 12 is a good default.
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------
PORT=4000
# Where the browser client runs. Used for CORS and for building password-reset links.
# Accepts a comma-separated list when the client is served from more than one origin.
# The API server's own origin is always allowed, so a single-origin deployment works
# without any extra configuration.
CLIENT_ORIGIN=http://localhost:5173
# Serve the built client (dist/client) from the API server. Set to false when the
# client is hosted separately.
SERVE_CLIENT=true

# ---------------------------------------------------------------------------
# Seeding
# ---------------------------------------------------------------------------
# The administrator account created by `npm run seed`.
SEED_ADMIN_EMAIL=admin@codeneptune.in
SEED_ADMIN_PASSWORD=Admin@12345
# A second management login, with its own password and no forced change.
SEED_MANAGER_EMAIL=info@codeneptune.com
SEED_MANAGER_PASSWORD=CodeNeptune
# The password issued to every other seeded account. Each of those accounts is
# forced to change it on first sign-in.
SEED_DEFAULT_PASSWORD=Welcome@123

# ---------------------------------------------------------------------------
# Password reset
# ---------------------------------------------------------------------------
# How long a reset link stays valid, in minutes.
RESET_TOKEN_TTL_MINUTES=30
