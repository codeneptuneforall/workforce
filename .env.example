# Copy this file to `.env` and adjust the values for your machine.
# `.env` is git-ignored — never commit real secrets.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local MongoDB. For an Atlas cluster use the SRV string instead:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/workforce
MONGODB_URI=mongodb://127.0.0.1:27017/workforce

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------
# Secret used to sign the session cookie. Use at least 32 random characters in
# production, for example: openssl rand -base64 48
JWT_SECRET=your-secure-random-secret-here
# How long a signed-in session stays valid, in hours.
SESSION_HOURS=8
# Password hashing cost. Higher is slower and safer; 12 is a good default.
BCRYPT_ROUNDS=12
# How long the in-memory app state is served before it is rebuilt from MongoDB, in ms.
# Lower = fresher data from writes outside the app, higher = fewer full DB reads.
STATE_CACHE_TTL_MS=60000

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------
PORT=4000
# Where the browser client runs. Used for CORS and for building password-reset links.
# Accepts a comma-separated list when the client is served from more than one origin.
# The API server's own origin is always allowed, so a single-origin deployment works
# without any extra configuration.
CLIENT_ORIGIN=http://localhost:5173
# Serve the built client (dist/client) from the API server. Set to false when the
# client is hosted separately.
SERVE_CLIENT=true
# Close the payslip PDF Chromium after this many ms without a render (frees ~200 MB).
PDF_BROWSER_IDLE_MS=120000
# Log process memory every N ms (0 disables). Watch for a steady climb in production.
MEMORY_LOG_INTERVAL_MS=300000

# Production only (set in the Render dashboard, not here): cap the Node heap so the
# process crashes and restarts cleanly instead of freezing near the instance limit.
# Leave room for Chromium (~200-300 MB) when sizing it:
#   512 MB plan -> --max-old-space-size=256
#   1 GB plan   -> --max-old-space-size=512
#   2 GB plan   -> --max-old-space-size=1280
# NODE_OPTIONS=--max-old-space-size=256

# ---------------------------------------------------------------------------
# File storage (Cloudinary): profile photos and bug tracker attachments
# ---------------------------------------------------------------------------
# Cloudinary Dashboard -> "API environment variable". Server-side only: never expose
# it to the client or commit the real value.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Root folder for every asset. Use a separate one locally so tests never mix with
# production files:
#   production (Render): workforce   -> workforce/profiles, workforce/bug-tracker/<issueKey>
#   local development:   workforce-dev
CLOUDINARY_FOLDER=workforce-dev

# ---------------------------------------------------------------------------
# Slack Integration (Phase A: local development only)
# ---------------------------------------------------------------------------
# Set SLACK_ENABLED=true to enable Slack leave approval notifications.
SLACK_ENABLED=false
# Bot token from Slack app (xoxb-...). Never commit this value.
SLACK_BOT_TOKEN=
# Signing secret from Slack app. Used to verify Slack request signatures.
SLACK_SIGNING_SECRET=
# Private channel ID for leave approvals (e.g. C0123456789).
SLACK_LEAVE_CHANNEL_ID=
# Comma-separated Slack user IDs authorized to approve/reject leave.
SLACK_ADMIN_USER_IDS=

# ---------------------------------------------------------------------------
# Seeding
# ---------------------------------------------------------------------------
# The administrator account created by `npm run seed`.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=your-secure-admin-password
# A second management login, with its own password and no forced change.
SEED_MANAGER_EMAIL=manager@example.com
SEED_MANAGER_PASSWORD=your-secure-manager-password
# The password issued to every other seeded account. Each of those accounts is
# forced to change it on first sign-in.
SEED_DEFAULT_PASSWORD=your-secure-default-password

# ---------------------------------------------------------------------------
# Password reset
# ---------------------------------------------------------------------------
# How long a reset link stays valid, in minutes.
RESET_TOKEN_TTL_MINUTES=30