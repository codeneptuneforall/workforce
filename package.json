{
  "name": "workforce-time-tracker-payroll",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Workforce time tracker and payroll platform — React client, Express API, MongoDB.",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "node ./node_modules/concurrently/dist/bin/concurrently.js -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node ./node_modules/tsx/dist/cli.mjs watch server/index.ts",
    "dev:web": "node ./node_modules/vite/bin/vite.js",
    "build": "npm run typecheck && node ./node_modules/vite/bin/vite.js build",
    "start": "node ./node_modules/tsx/dist/cli.mjs server/index.ts",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "lint": "node ./node_modules/eslint/bin/eslint.js . --ext .js,.jsx,.ts,.tsx",
    "seed": "node ./node_modules/tsx/dist/cli.mjs server/seed.ts",
    "db:reset": "node ./node_modules/tsx/dist/cli.mjs server/seed.ts --reset",
    "preview": "node ./node_modules/vite/bin/vite.js preview"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@types/multer": "^2.3.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "date-fns": "^4.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "framer-motion": "^11.5.4",
    "jsonwebtoken": "^9.0.2",
    "lottie-web": "^5.13.0",
    "lucide-react": "0.522.0",
    "mongoose": "^8.6.0",
    "multer": "^2.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^6.2.4",
    "react-router-dom": "^6.26.2",
    "sonner": "^2.0.1",
    "tailwind-merge": "latest",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.11.18",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^5.54.0",
    "@typescript-eslint/parser": "^5.54.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "latest",
    "concurrently": "^8.2.2",
    "eslint": "^8.50.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.1",
    "postcss": "latest",
    "tailwindcss": "3.4.17",
    "typescript": "^5.5.4",
    "vite": "^6.4.5"
  }
}
